# Keep development files out of the dist archive that host apps install.
# resources/boost is shipped on purpose: Laravel Boost reads it from vendor/.
/.github            export-ignore
/docs               export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
/phpstan.neon.dist  export-ignore
/pint.json          export-ignore
/phpunit.xml.dist   export-ignore
