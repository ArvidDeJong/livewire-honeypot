{
  "name": "darvis/livewire-honeypot",
  "description": "Lightweight honeypot and time-trap spam protection for Livewire and Laravel forms, without CAPTCHAs.",
  "keywords": [
    "laravel",
    "livewire",
    "honeypot",
    "spam",
    "spam-protection",
    "forms",
    "laravel-boost"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/ArvidDeJong/livewire-honeypot",
  "authors": [
    {
      "name": "Arvid de Jong",
      "email": "info@arvid.nl"
    }
  ],
  "support": {
    "issues": "https://github.com/ArvidDeJong/livewire-honeypot/issues",
    "source": "https://github.com/ArvidDeJong/livewire-honeypot"
  },
  "autoload": {
    "psr-4": {
      "Darvis\\LivewireHoneypot\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Darvis\\LivewireHoneypot\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Darvis\\LivewireHoneypot\\HoneypotServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0|^13.0",
    "livewire/livewire": "^3.0|^4.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "phpunit/phpunit": "^11.0|^12.0|^13.0"
  },
  "scripts": {
    "test": "pest tests",
    "lint": "pint --test",
    "format": "pint",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
